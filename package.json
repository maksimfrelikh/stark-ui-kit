{
  "name": "stark-ui-kit",
  "version": "0.1.0",
  "description": "Portable design-token + base layer and headless UI utilities (focus trap, scroll lock, clipboard) with thin React hooks.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./src/styles/tokens.css",
    "./theme-mono.css": "./src/styles/theme-mono.css",
    "./prose.css": "./src/styles/prose.css",
    "./theme-toggle.css": "./src/styles/theme-toggle.css",
    "./lang-switch.css": "./src/styles/lang-switch.css"
  },
  "files": [
    "dist",
    "src/styles/tokens.css",
    "src/styles/theme-mono.css",
    "src/styles/prose.css",
    "src/styles/theme-toggle.css",
    "src/styles/lang-switch.css"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "tsup": "^8",
    "typescript": "^5"
  }
}
