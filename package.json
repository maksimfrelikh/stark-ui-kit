{
  "name": "stark-ui-kit",
  "version": "0.2.0",
  "description": "Portable design-token + base layer and headless UI utilities (focus trap, scroll lock, clipboard) with thin React hooks.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./styles.css": "./src/styles/tokens.css",
    "./theme-mono.css": "./src/styles/theme-mono.css",
    "./prose.css": "./src/styles/prose.css",
    "./theme-toggle.css": "./src/styles/theme-toggle.css",
    "./lang-switch.css": "./src/styles/lang-switch.css",
    "./command-palette.css": "./src/styles/command-palette.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/styles/tokens.css",
    "src/styles/theme-mono.css",
    "src/styles/prose.css",
    "src/styles/theme-toggle.css",
    "src/styles/lang-switch.css",
    "src/styles/command-palette.css"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/react.ts --format esm,cjs --dts --external react",
    "prepare": "npm run build",
    "design-system": "node scripts/design-system.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18",
    "tsup": "^8",
    "typescript": "^5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maksimfrelikh/stark-ui-kit.git"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
